{
  "name": "antislop",
  "version": "0.3.1",
  "description": "A deterministic linter for the mechanical tells of AI-generated prose.",
  "type": "module",
  "license": "MIT",
  "repository": "github:javidjamae/AntiSlop",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "antislop": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "RULES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/index.test.js",
    "prepare": "npm run build",
    "release": "node scripts/release.mjs",
    "corpus": "npm run build && node scripts/corpus.mjs",
    "corpus:fetch": "node scripts/corpus.mjs fetch",
    "corpus:report": "npm run build && node scripts/corpus.mjs report"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
